# RouteQible Quran Foundation API Proxy Configuration
# Obtain client credentials from https://api-docs.quran.com / Quran Foundation developer dashboard

# Client ID & Client Secret
QF_CLIENT_ID=your_client_id_here
QF_CLIENT_SECRET=your_client_secret_here

# Environment: "production" or "prelive"
QF_ENV=production

# Server Port
PORT=3000
